@article{bruggemannConsensusDenialClimate2014,
  title = {Between {{Consensus}} and {{Denial}}: {{Climate Journalists}} as {{Interpretive Community}}},
  shorttitle = {Between {{Consensus}} and {{Denial}}},
  author = {Br{\"u}ggemann, Michael and Engesser, Sven},
  year = {2014},
