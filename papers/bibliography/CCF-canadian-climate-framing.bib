  booktitle = {Proceedings of the 2022 {{Conference}} on {{Empirical Methods}} in {{Natural Language Processing}}},
  author = {Hershcovich, Daniel and Webersinke, Nicolas and Kraus, Mathias and Bingler, Julia and Leippold, Markus},
