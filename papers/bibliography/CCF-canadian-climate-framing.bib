@article{panFramingAnalysisApproach1993,
  title = {Framing Analysis: {{An}} Approach to News Discourse},
  shorttitle = {Framing Analysis},
  author = {Pan, Zhongdang and {and Kosicki}, Gerald M.},
  year = {1993},
