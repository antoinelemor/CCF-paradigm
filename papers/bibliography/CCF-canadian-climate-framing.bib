@article{bayesResearchAgendaClimate2023,
  title = {A {{Research Agenda}} for {{Climate Change Communication}} and {{Public Opinion}}: {{The Role}} of {{Scientific Consensus Messaging}} and {{Beyond}}},
  shorttitle = {A {{Research Agenda}} for {{Climate Change Communication}} and {{Public Opinion}}},
  author = {Bayes, Robin and Bolsen, Toby and Druckman, James N.},
  year = {2023},
