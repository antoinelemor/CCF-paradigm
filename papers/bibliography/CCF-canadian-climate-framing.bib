@article{marisadispensaMediasSocialConstruction2003,
  title = {Media's Social Construction of Environmental Issues: Focus on Global Warming -- a Comparative Study},
  shorttitle = {Media's Social Construction of Environmental Issues},
  author = {Marisa Dispensa, Jaclyn and Brulle, Robert J.},
  year = {2003},
  month = jan,
  journal = {International Journal of Sociology and Social Policy},
  volume = {23},
  number = {10},
  pages = {74--105},
  publisher = {MCB UP Ltd},
  issn = {0144-333X},
  doi = {10.1108/01443330310790327},
  urldate = {2024-06-25},
  abstract = {Global warming has been a well recognized environmental issue in the United States for the past ten years, even though scientists had identified it as a potential problem years before in 1896. We find debate about the issue in the United States media coverage while controversy among the majority of scientists is rare. The role that media plays in constructing the norms and ideas in society is researched to understand how they socially construct global warming and other environmental issues. To identify if the U.S. Media presents a biased view of global warming, the following are discussed (1) the theoretical perspective of media and the environment; (2) scientific overview and history of global warming; (3) media coverage of global warming, and (4) research findings from the content analysis of three countries' newspaper articles and two international scientific journals produced in 2000 with comparison of these countries economies, industries, and environments. In conclusion, our research demonstrates that the U.S. with differing industries, predominantly dominated by the fossil fuel industry, in comparison to New Zealand and Finland has a significant impact on the media coverage of global warming. The U.S's media states that global warming is controversial and theoretical, yet the other two countries portray the story that is commonly found in the international scientific journals. Therefore, media, acting as one driving force, is providing citizens with piecemeal information that is necessary to assess the social, environmental and political conditions of the country and world.},
  keywords = {Environmental health and safety,Global warming,USA},
  file = {/Users/antoine/Zotero/storage/6HNQWD8D/Marisa Dispensa and Brulle - 2003 - Media’s social construction of environmental issue.pdf}
}

