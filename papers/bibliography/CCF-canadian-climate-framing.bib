@article{bolstadGrowingDeviationsElite2024,
  title = {Growing Deviations between Elite and Non-Elite Media Coverage of Climate Change in the {{United States}}},
  author = {Bolstad, Parker and Victor, David G.},
  year = {2024},
  month = jun,
  journal = {Climatic Change},
  volume = {177},
