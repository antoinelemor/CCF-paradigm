@article{ConstructingClimateChange1996,
  title = {Constructing Climate Change: Claims and Frames in {{US}} News Coverage of an Environmental Issue},
  shorttitle = {Constructing Climate Change},
  author = {, Craig Trumbo},
  year = {1996},
  month = jul,
  journal = {Public Understanding of Science},
  volume = {5},
  number = {3},
  pages = {269},
  issn = {0963-6625},
  doi = {10.1088/0963-6625/5/3/006},
  urldate = {2025-06-25},
  abstract = {An empirical content analysis of a decade of coverage of climate change in five national newspapers in the US is presented. The analysis is based on the perspective, drawn from social problems theory, that the content of news discourse can be understood in terms of claims-making and framing. Climate change is also discussed in terms of Downs' issue - attention cycle, a five-stage model describing the rise and fall of social attention to important issues. Climate change, as a news story, is described as exhibiting three phases that are related to the sources quoted and the frames presented in the news coverage. Results of the analysis show that scientists tend to be associated with frames emphasizing problems and causes, while politicians and special interests tend to be associated with frames emphasizing judgments and remedies. Results also show how scientists declined as news sources as the issue became increasingly politicized. La construction de l'{\'e}volution du climat: affirmations et sch{\'e}mas de pr{\'e}sentation dans la couverture m{\'e}diatique am{\'e}ricaine d'une question d'environnement R{\'e}sum{\'e}. Nous pr{\'e}sentons l'analyse empirique du contenu de dix ans de reportage concernant l'{\'e}volution du climat dans cinq quotidiens am{\'e}ricains. Cette analyse repose sur la perspective, tir{\'e}e de la th{\'e}orie des probl{\`e}mes sociaux, que le contenu du discours des nouvelles peut {\^e}tre compris en termes d'affirmations et de sch{\'e}mas de pr{\'e}sentation. L'{\'e}volution du climat est aussi examin{\'e}e par rapport au cycle de Downs, un mod{\`e}le en cinq {\'e}tapes d{\'e}crivant les variations de l'attention port{\'e}e par la soci{\'e}t{\'e} aux questions importantes. L'{\'e}volution climatique, en tant que nouvelle, est d{\'e}crite comme pr{\'e}sentant trois phases li{\'e}es aux sources cit{\'e}es et aux sch{\'e}mas de pr{\'e}sentation introduits dans les articles. Les r{\'e}sultats de cette analyse indiquent que les scientifiques tendent {\`a} {\^e}tre associ{\'e}s avec les sch{\'e}mas qui soulignent les probl{\`e}mes et les causes, tandis que les politiciens et les int{\'e}r{\^e}t sp{\'e}ciaux tendent {\`a} {\^e}tre associ{\'e}s avec ceux qui soulignent les jugements et les rem{\`e}des. Les r{\'e}sultats indiquent aussi que l'importance attach{\'e}e aux scientifiques en tant que source d'informations diminue plus la question se politise. Construcci{\'o}n del cambio clim{\'a}tico: afirmaciones y n{\'u}cleos en la cobertura informativa de una cuesti{\'o}n medioambiental en los EE UU Res{\'u}men. Se presenta un an{\'a}lisis emp{\'i}rico del contenido de una d{\'e}cada de cobertura de los cambios clim{\'a}ticos por parte de cinco peri{\'o}dicos nacionales de los EE UU. El an{\'a}lisis se basa en la perspectiva, extra{\'i}da de la teor{\'i}a de los problemas sociales, de que el contenido de las noticias puede entenderse en base a afirmaciones y n{\'u}cleos. El cambio clim{\'a}tico tambi{\'e}n se discute en base al ciclo de atenci{\'o}n a cuestiones de Downs, es decir, un modelo de cinco fases que describe el incremento y disminuci{\'o}n de la atenci{\'o}n social prestada a cuestiones importantes. Se describe que el cambio clim{\'a}tico, como noticia, presenta tres fases que se relacionan con las fuentes indicadas y con los n{\'u}cleos expuestos en la cobertura informativa. Los resultados del an{\'a}lisis muestran que los cient{\'i}ficos tienden a ser asociados con los n{\'u}cleos que enfatizan los problemas y las causas, mientras que los pol{\'i}ticos e intereses especiales tienden a ser asociados con los n{\'u}cleos que enfatizan juicios y remedios. Asimismo, los resultados muestran c{\'o}mo los cient{\'i}ficos pierden predominancia como fuente informativa a medida que las cuestiones se politizan cada vez m{\'a}s.},
  langid = {english},
  file = {/Users/antoine/Zotero/storage/UDEFZAAV/1996 - Constructing climate change claims and frames in .pdf}
}

