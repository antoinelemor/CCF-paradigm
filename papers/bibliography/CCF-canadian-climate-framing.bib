  title = {What Drives Media Attention for Climate Change? {{Explaining}} Issue Attention in {{Australian}}, {{German}} and {{Indian}} Print Media from 1996 to 2010},
  shorttitle = {What Drives Media Attention for Climate Change?},
  author = {Sch{\"a}fer, Mike S and Ivanova, Ana and Schmidt, Andreas},
  year = {2014},
