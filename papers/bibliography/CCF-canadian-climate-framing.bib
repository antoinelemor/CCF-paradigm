  shorttitle = {Actors and Justifications in Media Debates on {{Arctic}} Climate Change in {{Finland}} and {{Canada}}},
  author = {Kukkonen, Anna and Stoddart, Mark CJ and {Yl{\"a}-Anttila}, Tuomas},
  year = {2021},
