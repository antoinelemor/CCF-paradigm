  keywords = {agenda setting,comparative policy studies,media,policy process,state/local governments},
  file = {/Users/antoine/Zotero/storage/VUVSMU3F/Eissler et al. - 2014 - New Avenues for the Study of Agenda Setting.pdf}
}

@article{ekayaniRoleScientistsForest2016,
  title = {The Role of Scientists in Forest Fire Media Discourse and Its Potential Influence for Policy-Agenda Setting in {{Indonesia}}},
