  shorttitle = {Ten Years to Prevent Catastrophe?},
  author = {Doulton, Hugh and Brown, Katrina},
  year = {2009},
  month = may,
  journal = {Global Environmental Change},
  series = {Traditional {{Peoples}} and {{Climate Change}}},
  volume = {19},
