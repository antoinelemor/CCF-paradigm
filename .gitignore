# Papers - allow LaTeX, figures, and bibliography
# But still ignore auxiliary LaTeX files
papers/**/*.aux
papers/**/*.bbl
papers/**/*.blg
papers/**/*.fdb_latexmk
papers/**/*.fls
papers/**/*.log
papers/**/*.out
papers/**/*.synctex.gz
papers/**/*.toc
papers/**/*.lof
papers/**/*.lot
papers/**/*.nav
papers/**/*.snm
papers/**/*.vrb
papers/**/*.bcf
papers/**/*.run.xml
papers/**/*-blx.bib

# Allow important paper files
!papers/**/*.tex
!papers/**/*.bib
!papers/**/*.png
!papers/**/*.jpg
!papers/**/*.pdf
!papers/**/*.eps
!papers/**/*.svg